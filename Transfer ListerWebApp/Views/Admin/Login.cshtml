@model Transfer_ListerWebApp.Models.AdminLoginViewModel

@{
    ViewData["Title"] = "Administrator Login";
}

<div class="container mt-5" style="max-width: 450px;">

    <h2 class="text-center mb-4">Administrator Login</h2>

    <form asp-controller="Admin" asp-action="Login" method="post">

        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label p-2">
                Username
            </label>

            <input asp-for="Username"
                   class="form-control"
                   autocomplete="username" />

            <span asp-validation-for="Username"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label p-2">
                Password
            </label>

            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   autocomplete="current-password" />

            <span asp-validation-for="Password"
                  class="text-danger">
            </span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Login
        </button>

        <a asp-controller="TransferListerWebApp"
           asp-action="Index"
           class="btn btn-secondary w-100 mt-2">
            Back to Transfer List
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}